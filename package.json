{
  "name": "offerflow",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:web\"",
    "dev:job-memory-v2": "tsx scripts/devJobMemoryV2.ts",
    "web": "vite",
    "server": "tsx server/index.ts",
    "db:init": "tsx server/schema.ts",
    "db:doctor": "tsx scripts/dbDoctor.ts",
    "db:sync": "tsx scripts/dbSync.ts",
    "db:backup": "tsx scripts/dbBackup.ts",
    "db:export": "tsx scripts/dbExport.ts",
    "db:import": "tsx scripts/dbImport.ts",
    "db:publish": "tsx scripts/dbPublishSnapshot.ts",
    "db:pull": "tsx scripts/dbPullSnapshot.ts",
    "db:checkpoint": "tsx scripts/dbCheckpoint.ts",
    "import:backup": "tsx scripts/importBackupToDb.ts",
    "import:jd-drafts": "tsx scripts/importJdDrafts.ts",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:router": "node scripts/runRouterSmoke.mjs",
    "job-memory-v2:smoke": "tsx scripts/devJobMemoryV2.ts --smoke",
    "job-memory-v2:upgrade": "tsx scripts/jobMemoryV2Upgrade.ts",
    "job-memory-v2:upgrade-selftest": "vitest run server/job-memory/upgrade server/snapshot/v2.spec.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "migration:selftest": "tsx scripts/migrations.selftest.ts",
    "snapshot:check": "tsx scripts/snapshotConsistency.ts",
    "snapshot:roundtrip": "tsx scripts/snapshotRoundtrip.ts",
    "snapshot:selftest": "tsx scripts/snapshotConsistency.selftest.ts",
    "sync:selftest": "tsx scripts/sync.selftest.ts",
    "selftest": "tsx scripts/storage.selftest.ts && tsx scripts/offerFlowJson.selftest.ts && tsx scripts/targetProfileScore.selftest.ts && tsx scripts/decision.selftest.ts && tsx scripts/reviewWorkflow.selftest.ts && tsx scripts/jdImageOcr.selftest.ts && tsx scripts/migrations.selftest.ts && tsx scripts/sync.selftest.ts && tsx scripts/snapshotConsistency.selftest.ts",
    "eval:offerflow-json": "tsx scripts/offerFlowJson.eval.ts"
  },
  "dependencies": {
    "fastify": "^5.9.0",
    "naive-ui": "^2.44.1",
    "nanoid": "^5.1.16",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13",
    "vue-page-runtime": "0.2.0-alpha.5",
    "vue-page-scope": "^0.2.0",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.3",
    "happy-dom": "^20.10.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
