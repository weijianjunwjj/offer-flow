# OfferFlow 服务端环境变量示例
# ------------------------------------------------------------------
# 用法：复制本文件为 .env.local（优先）或 .env，填入真实值。
# 两者均已被 .gitignore 忽略；.env.local 覆盖 .env，真实进程环境变量最高优先。
# 仅服务端加载（server/**），绝不使用 VITE_ 前缀，绝不注入浏览器 bundle。
# 本文件只放空占位符，禁止写入真实密钥。
#
# DeepSeek（OpenAI 兼容接口）配置。优先读 OFFERFLOW_LLM_*，回退 DEEPSEEK_*。
# 三者缺一即视为未配置（server/llm/provider.ts::getMissingLlmConfigFields）。

# API Key（服务端密钥，切勿提交真实值）
OFFERFLOW_LLM_API_KEY=
# Base URL，例如 https://api.deepseek.com（无需结尾 /v1，代码自动补 /v1/chat/completions）
OFFERFLOW_LLM_BASE_URL=
# 模型名，例如 deepseek-chat
OFFERFLOW_LLM_MODEL=

# 兼容回退变量名（与上面二选一即可，不要重复填）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# 可选调优（缺省见 server/llm/provider.ts）
# OFFERFLOW_LLM_MAX_TOKENS=1800
# OFFERFLOW_LLM_TEMPERATURE=0.2
# OFFERFLOW_LLM_TIMEOUT_MS=30000
# OFFERFLOW_LLM_RETRY_MAX=2
